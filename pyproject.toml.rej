diff a/pyproject.toml b/pyproject.toml	(rejected hunks)
@@ -77,12 +91,14 @@ select = [
     "UP",
     # isort
     "I",
-    # pylint 
+    # pylint
     "PL",
 ]
 
 ignore = [
     "F403", # 'from module import *' used; unable to detect undefined names
+    "PLC0415", # `import` should be at the top-level of a file
+    "E501", # line too long
 ]
 
 fixable = ["ALL"]
@@ -90,6 +106,9 @@ fixable = ["ALL"]
 # Allow unused variables when underscore-prefixed.
 dummy-variable-rgx = "^(_+|(_+[a-zA-Z0-9_]*[a-zA-Z0-9]+?))$"
 
+[tool.ruff.lint.per-file-ignores]
+"__init__.py" = ["PLC0415"] # import-outside-top-level
+
 # this is entirely optional, you can remove this if you wish to
 [tool.ruff.format]
 # use single quotes for strings.
@@ -116,6 +135,8 @@ schema_package_entry_point = "nomad_lap_schema.schema_packages:schema_package_en
 normalizer_entry_point = "nomad_lap_schema.normalizers:normalizer_entry_point"
 app_entry_point = "nomad_lap_schema.apps:app_entry_point"
 example_upload_entry_point = "nomad_lap_schema.example_uploads:example_upload_entry_point"
+action_entry_point = "nomad_lap_schema.actions:simple_action_entry_point"
+
 [tool.cruft]
 # Avoid updating workflow files, this leads to permissions issues
 skip = [".github/*"]
